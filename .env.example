# =============================================================================
# Heatr — Environment Variables
# Copy to .env and fill in real values. Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co        # Project URL from Supabase dashboard → Settings → API
SUPABASE_KEY=your_service_role_key                   # Service role key (NOT anon key) — full DB access
SUPABASE_STORAGE_BUCKET=screenshots                  # Storage bucket name for website screenshots

# -----------------------------------------------------------------------------
# Anthropic
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...                         # Anthropic API key — Haiku for bulk, Sonnet for Vision

# -----------------------------------------------------------------------------
# KvK (Kamer van Koophandel)
# -----------------------------------------------------------------------------
KVK_API_KEY=your_kvk_api_key                         # KvK API key — email fallback step 4, NL only

# -----------------------------------------------------------------------------
# Warmr
# -----------------------------------------------------------------------------
WARMR_API_URL=https://your-warmr.com/api/v1          # Base URL of your Warmr instance
WARMR_API_KEY=wrmr_your_warmr_api_key                # Warmr API key for push/campaign endpoints (format: wrmr_<64hex>)
WARMR_WEBHOOK_SECRET=your_hmac_secret                # HMAC secret to verify incoming Warmr webhooks
ENABLE_CAMPAIGN_SENDS=false                          # LEGACY kill-switch — fallback voor ENABLE_PROSPECT_SENDS (WP-A 2026-07-10)
ENABLE_PROSPECT_SENDS=false                          # Centrale kill-switch: gate't ALLE prospect-sends in de dispatcher (launch, follow-ups, ad-hoc pushes, review-mails). Leidend boven ENABLE_CAMPAIGN_SENDS.
ENABLE_INTERNAL_NOTIFICATIONS=true                   # Aparte switch voor operator-briefings/alerts — een campagne-stop dempt geen interne meldingen
OUTBOUND_INFLIGHT_STALE_MINUTES=15                   # Na hoeveel min een in_flight-ledgerreservering als gecrasht geldt (stale-takeover)
HEATR_JWT_WORKSPACE_FALLBACK=false                   # Fase 4: JWT zonder workspace_id-claim wordt GEWEIGERD. Alleen "true" tijdens frontend-cutover (provision eerst de claims — zie runbook)
PLATFORM_DAILY_BUDGET_EUR=0                          # Fase 4: globaal AI-kostenplafond/dag over ALLE workspaces. 0 = uit. ZET AAN voor er een tweede tenant komt (bv. 25)
PLATFORM_MONTHLY_BUDGET_EUR=0                        # Fase 4: globaal AI-kostenplafond/maand. 0 = uit. Waarschuwt op 70/85/95%, harde stop op 100%
# -----------------------------------------------------------------------------
# Playwright
# -----------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true                             # true = headless Chromium, false = visible (debug)
SCRAPE_DELAY_MIN=2                                   # Minimum seconds between page actions (anti-detection)
SCRAPE_DELAY_MAX=6                                   # Maximum seconds between page actions (anti-detection)
MAX_CONCURRENT_SCRAPERS=3                            # Max parallel Playwright browser contexts
GOOGLE_MAPS_MAX_RESULTS=60                           # Max leads to scrape per Google Maps search

# -----------------------------------------------------------------------------
# Proxy (disabled by default)
# -----------------------------------------------------------------------------
PROXY_ENABLED=false                                  # Set true to route Playwright through a proxy
PROXY_URL=http://user:pass@proxy.host:port           # Full proxy URL with credentials
PROXY_COUNTRY=NL                                     # Request NL exit node (for NL-specific content)

# -----------------------------------------------------------------------------
# Enrichment
# -----------------------------------------------------------------------------
EMAIL_VERIFY_TIMEOUT=10                              # Seconds before SMTP verification times out
MAX_CONCURRENT_ENRICHMENTS=5                         # Max leads enriching in parallel
CATCHALL_CHECK_ENABLED=true                          # Detect and penalise catch-all email servers

# -----------------------------------------------------------------------------
# Website Intelligence
# -----------------------------------------------------------------------------
PAGESPEED_API_KEY=your_google_pagespeed_api_key      # Google PageSpeed Insights API key (free tier: 400 req/day)
SCREENSHOT_ENABLED=true                              # Enable Playwright full-page screenshots
COMPETITOR_ANALYSIS_ENABLED=true                     # Enable Layer 5 competitor comparison
COMPETITOR_COUNT=3                                   # Number of local competitors to compare against

# -----------------------------------------------------------------------------
# Scoring / Warmr push thresholds
# -----------------------------------------------------------------------------
MIN_SCORE_FOR_WARMR=55                               # Lead score minimum to allow Warmr push (herijkt 2026-07 na icp-normalisatie; was 65)
MIN_ICP_MATCH_FOR_WARMR=0.50                         # ICP match minimum (0.0–1.0) to allow Warmr push (herijkt 2026-07; was 0.6)
MIN_WEBSITE_SCORE_FOR_OPPORTUNITY=50                 # Website scores below this flag an opportunity
AUTO_PUSH_TO_WARMR=false                             # If true, qualified leads push automatically (risky!)

# -----------------------------------------------------------------------------
# GDPR
# -----------------------------------------------------------------------------
GDPR_MODE=strict                                     # strict = personal emails blocked; relaxed = warned only

# -----------------------------------------------------------------------------
# Workspace
# -----------------------------------------------------------------------------
DEFAULT_WORKSPACE_ID=aerys                           # Default workspace slug for single-tenant deploys

# -----------------------------------------------------------------------------
# API Auth (added in commit 5a8e397)
# -----------------------------------------------------------------------------
HEATR_API_KEY=                                       # Service-to-service X-API-Key header (min 32 chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SUPABASE_JWT_SECRET=                                 # Supabase JWT secret for HS256 decode — from Supabase dashboard → Settings → API → JWT Secret
# LEGACY_DEV_TOKEN_ALLOWED: escape-hatch tijdens frontend-cutover.
#   AAN  ("true")  = elke Bearer-token wordt geaccepteerd. Alleen zetten zolang
#                    frontend-next/ nog "Bearer dev-token" stuurt (huidige staat).
#   UIT  ("false") = alleen X-API-Key of geldige Supabase JWT. Verplicht zodra
#                    frontend-next Supabase Auth gebruikt, en ALTIJD in productie
#                    met externe toegang.
#   Diagnose: GET /healthz → "auth" toont welke modes actief zijn (geen auth nodig).
#   Frontend toont een rode "Niet geautoriseerd"-banner bij 401/403.
LEGACY_DEV_TOKEN_ALLOWED=false

# -----------------------------------------------------------------------------
# Misc runtime-config (gevonden in code maar ontbrak hier — audit 2026-07-05)
# -----------------------------------------------------------------------------
HEATR_BASE_URL=http://localhost:8001                 # Absolute base-URL voor links in briefing-emails (api/main.py). VERPLICHT aanpassen voor productie — anders breken email-links.
HEATR_SCHEDULING_URL=                                # Optioneel: booking-link (Calendly/Cal.com) die reply_drafter in draft-antwoorden verwerkt. Leeg = geen booking-link.
SENDER_NAME=Sami                                     # Afzendernaam in review-emails (campaigns/review_email_generator.py)
RECONTACT_COOLDOWN_DAYS=90                           # Minimum dagen tussen contactpogingen op dezelfde lead (campaigns/sequence_engine.py)
HEATR_TABLE_PREFIX=heatr_                            # Supabase tabel-prefix voor shared-database setup (config/database.py)
HEATR_EUR_USD_RATE=0.93                              # EUR/USD-koers voor Anthropic-kostencalculatie (utils/cost_guard.py)

# -----------------------------------------------------------------------------
# E-mailverificatie via externe API (remediation C1)
# -----------------------------------------------------------------------------
EMAIL_VERIFY_PROVIDER=bouncer                        # bouncer | none. Externe verify-API voor de risky/not_checked-bucket (SMTP is fail-closed maar werkt niet vanaf een host met dichte poort 25)
BOUNCER_API_KEY=                                      # Bouncer API-key (usebouncer.com, EU/GDPR). Leeg = externe verificatie uit

# -----------------------------------------------------------------------------
# Check-up follow-up (migratie 032)
# -----------------------------------------------------------------------------
CHECKUP_REPORT_ENABLED=false                          # Kill-switch voor rapport-verzending. LOS van ENABLE_CAMPAIGN_SENDS zodat deze flow te testen is zonder outbound-campagnes aan te zetten.
CHECKUP_REPORT_URL_TTL_DAYS=30                         # Verloop van de signed URL naar de rapport-PDF (Storage). Semi-gevoelig -> niet permanent open.
CHECKUP_WARMR_CAMPAIGN_ID=                             # OPTIONEEL: Warmr-campagne/template voor de cover-mail ({{custom_body}} draagt de rapport-link). Leeg -> ready inbox als fallback (zoals send-review-email).
RETARGET_MAX_ATTEMPTS=2                                # Globale cap op retarget-pogingen (per-uitkomst max_attempts staat in config/retarget_cadence.py)
AERYS_OWN_EMAILS=sami@aeryssolution.nl                # Comma-separated eigen adressen; uit de Zoom-participants gefilterd vóór matching (fail-closed)

# Zoom (fase 8 — code gebouwd maar UIT; Zoom-plan met cloud recording + audio transcript + webhook nog niet actief)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
