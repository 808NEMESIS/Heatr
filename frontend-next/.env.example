# Kopieer naar .env. Alleen VITE_-prefixed vars bereiken de browser-bundle.
# Deze zijn publiek (geen secrets).

# Backend-base (proxy in dev via vite.config; leeg laten = /api).
# VITE_API_BASE=/api

# Gedeelde Supabase-sessie (A0 operator-shell) — zelfde project als Warmr.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optioneel: origin waarop de Warmr-app draait (prod reverse-proxy target).
# VITE_WARMR_ORIGIN=http://localhost:8000
