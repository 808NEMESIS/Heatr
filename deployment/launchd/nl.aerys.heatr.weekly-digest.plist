<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>nl.aerys.heatr.weekly-digest</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/nemesis/Heatr/scripts/weekly_digest.py</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/nemesis/Heatr/logs/weekly-digest.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/nemesis/Heatr/logs/weekly-digest.out.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>8</integer>
		<key>Minute</key>
		<integer>0</integer>
		<key>Weekday</key>
		<integer>1</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/nemesis/Heatr</string>
</dict>
</plist>
