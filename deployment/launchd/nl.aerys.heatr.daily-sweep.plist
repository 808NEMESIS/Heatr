<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>nl.aerys.heatr.daily-sweep</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/Users/nemesis/Heatr/scripts/run_daily_sweep.sh</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/nemesis/Heatr/logs/daily-sweep.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/nemesis/Heatr/logs/daily-sweep.out.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>10</integer>
	</dict>
</dict>
</plist>
